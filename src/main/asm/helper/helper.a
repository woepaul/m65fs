; helper.a -- the m65fs transfer helper (part of m65fs, GPL-3).
;
; Serves the MEGA65's SD card to m65fs over Ethernet: the protocol of mega65-tools'
; remotesd_eth ("mreq"/"mrsp" over UDP port 4510, IPv6 link-local), restricted to what m65fs
; uses (see io.github.paw.m65fs.remotesd.Request and Response):
;   $FD hello        locks the session to the sender (address and port); answers with the
;                    helper's version (HELPER_VERSION)
;   $15 release      unlocks it again: the next hello may come from another client (the next
;                    tool reuses the running helper instead of triggering and loading it again)
;   $04 read         up to 128 sectors, one answer per sector
;   $02 write        one sector, or one sector of a batch of 2..128 (written in order as the
;                    sectors arrive, read back and compared when the batch is complete)
;   $11 memory       read up to 256 bytes at a 28-bit address
;   $12 mount        attach a D81 from the root directory as drive 0
;   $13 cwd          report (and set) the hypervisor's working directory
;   $14 text         a line for the log on the helper's screen (m65fs shows what it does)
;   $FF quit         answer, then reset into MEGA65 mode
; and answers IPv6 neighbor solicitations for its own address.
;
; Started with the START ethlet's jump mode (no ROM initialisation), at its load address.
; Runs with interrupts off and needs nothing from the ROM (except its character set). Copies
; are done by DMA, UDP checksums with 32-bit additions (ADCQ).
;
; The screen (80 x 50) shows the state, statistics (updated every second: requests, KiB read
; and written, rates) and the lines m65fs sends. The border is red while requests come in and
; green when the helper is idle: no write batch open, no request for 5 seconds. Then RUN/STOP
; or ESC quits into MEGA65 mode (BASIC 65).
;
; Assemble with ACME: acme --cpu m65 -f cbm -o helper.prg helper.a

!cpu m65

HELPER_VERSION = 1              ; in the hello answer; m65fs only reuses a running helper of
                                ; its own version (RemoteSdSession.HELPER_VERSION)

; ---------------------------------------------------------------- memory
SCREEN  = $3000                 ; 80 x 50 = 4000 bytes
COLS    = 80
ROWS    = 50
CHARSET = $2d800                ; the ROM's lower case character set
RXLEN   = $1ffe                 ; DMA copy of the RX buffer: 2 length bytes,
RXBUF   = $2000                 ; then the received frame
TXBUF   = $2400                 ; reply frame (Ethernet, IPv6, UDP, payload)
NDBUF   = $2700                 ; neighbor advertisement frame
VBUF1   = $2800                 ; 512-byte compare buffers
VBUF2   = $2a00
NAMEBUF = $2c00                 ; file/directory name for the hypervisor (page aligned)
FLAGS   = $2d00                 ; per batch slot: sector received
CACHE   = $40000                ; batch sectors (128 x 512 bytes)
ETHBUF  = $ffde800              ; Ethernet buffer: RX when read (length first), TX when written
SDBUF   = $ffd6e00              ; SD card sector buffer
COLRAM  = $ff80000

RXCOPY  = 2 + 600               ; bytes copied from the RX buffer (largest frame: 588 + padding)

; frame offsets (RXBUF and TXBUF alike)
F_ETHSRC = 6
F_TYPE   = 12
F_IPLEN  = 18
F_NH     = 20
F_IPSRC  = 22
F_IPDST  = 38
F_UDP    = 54                   ; source port, destination port, length, checksum
F_PL     = 62                   ; UDP payload: "mreq"/"mrsp", sequence number, opcode, ...
F_SEQ    = 66
F_OP     = 68
F_ARG    = 69                   ; payload offset 7
PORT     = 4510

; ---------------------------------------------------------------- zero page
dma_src  = $02                  ; 28-bit addresses for dma_copy / dma_fill (4 bytes each)
dma_dst  = $06
dma_len  = $0a                  ; 2
cs_ptr   = $0c                  ; checksum: data pointer (2), dword count (1)
cs_cnt   = $0e
sum      = $10                  ; 4
csum     = $14                  ; 2: folded one's complement sum (little-endian over the data)
plen     = $16                  ; 2: reply payload length
client   = $18                  ; nonzero once hello locked the session
b_active = $19                  ; write batch
b_counter = $1a
b_max    = $1b                  ; batch size - 1
b_left   = $1c                  ; sectors still to receive
b_written = $1d                 ; next slot to write to the card
b_start  = $1e                  ; 4: first sector of the batch
r_left   = $22                  ; read batch: sectors left
r_sector = $23                  ; 4
tmp      = $27                  ; 4
ulen     = $2b                  ; 2: UDP length of the request
ptr      = $2d                  ; 2
cmd      = $2f
n_req    = $30                  ; 4: requests (valid "mreq" datagrams)
n_rd     = $34                  ; 4: sectors read
n_wr     = $38                  ; 4: sectors written
s_req    = $3c                  ; 4: the three counters a second ago
s_rd     = $40                  ; 4
s_wr     = $44                  ; 4
secs     = $48                  ; 4: seconds running
num      = $4c                  ; 4: number to print
bcd      = $50                  ; 5: num in BCD
lead     = $55                  ; bit 7: a digit was printed
frame    = $56                  ; frame counter ($D7FA) at the last second
fps      = $57                  ; frames per second (50 PAL, 60 NTSC)
idle     = $58                  ; seconds since the last request (up to 255)
tlen     = $59                  ; text: length
roff     = $5a                  ; 2: text: offset of its row

; ---------------------------------------------------------------- screen layout
!macro at .row, .col {
        !word SCREEN + .row * COLS + .col
}
IDLE_SECS  = 5                  ; idle: border green, RUN/STOP quits
ROW_STATUS = 2
ROW_STATS  = 4                  ; requests, read, written, running
ROW_LINE   = 9
ROW_LOG    = 10                 ; host lines up to the last row
LOG        = SCREEN + ROW_LOG * COLS
LOG_NEXT   = SCREEN + ROWS * COLS   ; row for the next log line (ROWS: full, scroll); right
                                ; after the screen, so that the next helper finds it too
COL_TOTAL  = 12                 ; numbers: 10 digits
COL_RATE   = 30

; ---------------------------------------------------------------- macros
!macro hyppo .call {
        lda #.call
        sta $d640
        clv
}

!macro set32 .var, .value {     ; .var = 32-bit constant
        lda #<.value
        ldx #>.value
        ldy #^.value
        ldz #(.value >> 24) & $ff
        stq .var
        ldz #$00
}

; copy .len bytes .src -> .dst (28-bit constants)
!macro copy .src, .dst, .len {
        +set32 dma_src, .src
        +set32 dma_dst, .dst
        lda #<.len
        ldx #>.len
        sta dma_len
        stx dma_len + 1
        jsr dma_copy
}

* = $0800
entry:
        sei
        cld
        lda #$47                ; MEGA65 I/O personality
        sta $d02f
        lda #$53
        sta $d02f
        lda #65                 ; 40 MHz
        sta $00
        lda #$00
        tab                     ; base page 0
        taz
        ldx #$7f                ; zero page variables
-       sta $02,x
        dex
        bpl -
        dec b_counter           ; $FF: no batch seen yet
        lda #$75                ; Ethernet: RX/TX on, multicast and broadcast, no promiscuous
        sta $d6e5               ; mode (as ETHLOAD)
        lda #$80
        tsb $d689               ; SD controller: its own sector buffer, not the floppy's
        +hyppo $4c              ; back to the working directory the trigger saved (patched
                                ; hypervisors; others just fail)
        jsr init_screen
        jsr init_frames
        lda #50
        bit $d06f               ; bit 7: NTSC
        bpl +
        lda #60
+       sta fps
        lda $d7fa
        sta frame

main:   jsr tick
        jsr keys
        lda $d6e1
        and #$20                ; frame received?
        beq main
        lda #$01                ; acknowledge it, show it in the RX buffer
        sta $d6e1
        lda #$03
        sta $d6e1
        +copy ETHBUF, RXLEN, RXCOPY
        jsr dispatch
        bra main

; ---------------------------------------------------------------- frame dispatch
dispatch:
        lda RXBUF + F_TYPE
        cmp #$86
        bne .out
        lda RXBUF + F_TYPE + 1
        cmp #$dd
        bne .out
        lda RXBUF + F_NH
        cmp #58
        lbeq icmp
        cmp #17
        bne .out
        ldx #15                 ; UDP to our address and port
-       lda RXBUF + F_IPDST,x
        cmp ip_local,x
        bne .out
        dex
        bpl -
        lda RXBUF + F_UDP + 2
        cmp #>PORT
        bne .out
        lda RXBUF + F_UDP + 3
        cmp #<PORT
        bne .out
        lda RXBUF + F_UDP + 5   ; UDP length (big-endian): 15..543 (fits the RX copy)
        sta ulen
        sta tmp
        lda RXBUF + F_UDP + 4
        sta ulen + 1
        sta tmp + 1
        beq +
        cmp #2
        bcc .lenok
        bne .out
        lda ulen
        cmp #$20
        bcc .lenok
.out:   rts
+       lda ulen
        cmp #15
        bcc .out
.lenok: ldx #3                  ; "mreq"
-       lda RXBUF + F_PL,x
        cmp mreq,x
        bne .out
        dex
        bpl -
        ; checksum: pad with zeros, then sum pseudo header + UDP
        lda #<(RXBUF + F_UDP)
        clc
        adc ulen
        sta ptr
        lda #>(RXBUF + F_UDP)
        adc ulen + 1
        sta ptr + 1
        lda #$00
        ldy #2
-       sta (ptr),y
        dey
        bpl -
        lda #<(RXBUF + F_IPSRC)
        ldx #>(RXBUF + F_IPSRC)
        jsr checksum_udp
        lda csum
        and csum + 1
        cmp #$ff
        bne .out                ; wrong checksum (or a frame with a CRC error): dropped
        ldq n_req
        inq
        stq n_req
        ldz #$00
        stz idle                ; a request: not idle
        lda #2                  ; border red: busy
        sta $d020
        lda RXBUF + F_OP
        cmp #$fd
        lbeq op_hello
        ldx client              ; everything else only from the locked client
        beq .out
        jsr same_client
        bne .out
        lda RXBUF + F_OP
        cmp #$02
        lbeq op_write
        cmp #$04
        lbeq op_read
        cmp #$11
        lbeq op_memory
        cmp #$12
        lbeq op_mount
        cmp #$13
        lbeq op_cwd
        cmp #$14
        lbeq op_text
        cmp #$15
        lbeq op_release
        cmp #$ff
        lbeq op_quit
        rts

; Z set if the request comes from the locked client (address and port)
same_client:
        ldx #15
-       lda RXBUF + F_IPSRC,x
        cmp TXBUF + F_IPDST,x
        bne +
        dex
        bpl -
        lda RXBUF + F_UDP
        cmp TXBUF + F_UDP + 2
        bne +
        lda RXBUF + F_UDP + 1
        cmp TXBUF + F_UDP + 3
+       rts

mreq:   !text "mreq"
mrsp:   !text "mrsp"

; ---------------------------------------------------------------- requests
op_hello:
        lda client
        beq +
        jsr same_client
        bne ++                  ; another client: ignored
        bra .hello_ack          ; repeated hello (answer lost): answer again
+       ldx #5                  ; lock: the client's MAC, address and port go into the reply
-       lda RXBUF + F_ETHSRC,x  ; frame
        sta TXBUF,x
        dex
        bpl -
        ldx #15
-       lda RXBUF + F_IPSRC,x
        sta TXBUF + F_IPDST,x
        dex
        bpl -
        lda RXBUF + F_UDP
        sta TXBUF + F_UDP + 2
        lda RXBUF + F_UDP + 1
        sta TXBUF + F_UDP + 3
        inc client
        lda #$ff                ; a new session (perhaps not the first of this helper): no batch
        sta b_counter           ; of an earlier one counts (its counter could come again)
        lda #$00
        sta b_active
        ldx #msg_connected - msgs
        jsr status
.hello_ack:
        lda #HELPER_VERSION
        sta TXBUF + F_ARG
        lda #8
        jmp reply
++      rts

op_release:                     ; answer, then unlock
        lda #7
        jsr reply
        lda #$00
        sta client
        ldx #msg_waiting - msgs
        jmp status

op_quit:
        lda #7
        jsr reply
        jsr wait_tx             ; let the answer leave
        ldx #$00
        ldy #$40
-       dex
        bne -
        dey
        bne -
quit65:                         ; from the keyboard: wait until the key is released (the ROM
        jsr wait_keys           ; starts its monitor if RUN/STOP is down at the reset)
reset65:                        ; reset into MEGA65 mode, as the START ethlet does
        lda #$80                ; the VIC as after power-on: hot registers on, 40 x 25 (the
        tsb $d05d               ; ROM sets up its screen from there)
        lda #$00
        sta $d031
        lda #$00
        ldx #$0f
        tay
        ldz #$0f
        map
        tax
        taz
        map
        eom
        lda #$3f
        sta $00
        sta $01
        lda #$40
        sta $00
        ldx #$ff
        txs
        ldy #$01
        tys
        see
        sta $d02f               ; C64 I/O personality
        jmp ($fffc)

op_memory:
        lda ulen
        cmp #20
        bne +
        ldq RXBUF + F_ARG + 1   ; address
        stq dma_src
        stq TXBUF + F_ARG + 1
        ldz #$00
        +set32 dma_dst, TXBUF + F_PL + 12
        lda RXBUF + F_ARG       ; count - 1
        sta TXBUF + F_ARG
        clc
        adc #1
        sta dma_len
        lda #$00
        adc #$00
        sta dma_len + 1
        jsr dma_copy
        lda dma_len
        clc
        adc #12
        sta plen
        lda dma_len + 1
        adc #$00
        sta plen + 1
        jmp reply_plen
+       rts

op_mount:
        ldx #0                  ; name: NUL-terminated, 1..63 characters
-       lda RXBUF + F_ARG,x
        sta NAMEBUF,x
        beq +
        inx
        cpx #64
        bne -
        rts                     ; no NUL: dropped
+       cpx #0
        beq ++
        jsr cdroot
        bcc +
        ldy #>NAMEBUF
        +hyppo $2e              ; setname
        bcc +
        +hyppo $40              ; attach as drive 0
+       lda #$00                ; status: 0 = mounted, 1 = error
        rol
        eor #$01
        sta TXBUF + F_ARG
        lda #8
        jmp reply
++      rts

op_cwd:
        lda RXBUF + F_ARG       ; mode
        beq .get
        cmp #1
        bne .drop
        ; set: cdroot, then setname/findfile/chdir for each name of the path
        ldx #0
-       lda RXBUF + F_ARG + 1,x
        beq +
        inx
        bpl -
.drop:  rts                     ; longer than 127 or no NUL: dropped
+       jsr cdroot
        bcc .fail
        ldx #0
.name:  ldy #0
-       lda RXBUF + F_ARG + 1,x
        beq +
        inx
        cmp #'/'
        beq +
        sta NAMEBUF,y
        iny
        bra -
+       lda #$00
        sta NAMEBUF,y
        cpy #0
        beq +                   ; empty name (leading, double or trailing '/')
        phx
        ldy #>NAMEBUF
        +hyppo $2e              ; setname
        bcc .failx
        +hyppo $34              ; findfile
        bcc .failx
        +hyppo $0c              ; chdir
        bcc .failx
        plx
+       lda RXBUF + F_ARG + 1,x ; next character: NUL = end
        bne .name
.get:   +hyppo $0a              ; getcwd: cluster in Q
        bcc .fail
        stq TXBUF + F_ARG + 2
        ldz #$00
        +hyppo $04              ; current drive
        sta TXBUF + F_ARG + 1
        lda #$00
        bra .status
.failx: plx
.fail:  cmp #$00                ; hypervisor error code (0: none given)
        bne +
        lda #$ff
+       ldx #$00
        stx TXBUF + F_ARG + 1
        stx TXBUF + F_ARG + 2
        stx TXBUF + F_ARG + 3
        stx TXBUF + F_ARG + 4
        stx TXBUF + F_ARG + 5
.status:
        sta TXBUF + F_ARG
        lda #13
        jmp reply

cdroot: +hyppo $04              ; current drive
        tax
        +hyppo $3c              ; cdroot
        rts

; ---------------------------------------------------------------- read sectors
op_read:
        lda ulen
        cmp #21
        bne +
        lda RXBUF + F_ARG + 1   ; sector count > 256: not supported
        bne +
        lda b_active
        beq ++
        ldx #msg_mixed - msgs
        jmp fatal
+
.rrts:  rts
++      lda RXBUF + F_ARG       ; count - 1
        cmp #128
        bcs .rrts
        inc
        sta r_left
        ldq RXBUF + F_ARG + 2
        stq r_sector
        ldz #$00
        lda RXBUF + F_SEQ
        sta TXBUF + F_SEQ
        lda RXBUF + F_SEQ + 1
        sta TXBUF + F_SEQ + 1
        lda #$04
        sta TXBUF + F_OP
        lda #$00
        sta TXBUF + F_ARG
        sta TXBUF + F_ARG + 1
        jsr sd_read             ; first sector
.next:  jsr sd_wait
        +copy SDBUF, TXBUF + F_PL + 13, 512
        ldq r_sector
        stq TXBUF + F_ARG + 2
        inq                     ; next sector
        stq r_sector
        ldz #$00
        dec r_left
        beq +
        jsr sd_read             ; read the next sector while this one is sent
+       lda #<525
        sta plen
        lda #>525
        sta plen + 1
        jsr send
        ldq n_rd
        inq
        stq n_rd
        ldz #$00
        inc TXBUF + F_SEQ       ; consecutive sequence numbers
        bne +
        inc TXBUF + F_SEQ + 1
+
        lda r_left
        bne .next
        rts

; ---------------------------------------------------------------- write sectors
op_write:
        lda ulen + 1            ; 534 = $216
        cmp #>534
        lbne .ignore
        lda ulen
        cmp #<534
        lbne .ignore
        lda RXBUF + F_ARG + 1   ; batch size - 1
        lbne batch
        ; single sector, written and verified right away
        lda b_active
        beq +
        jsr outdated
        lbcs .ignore             ; late retransmission of an old batch
        ldx #msg_conflict - msgs
        jmp fatal
+       jsr outdated
        lbcs .ignore             ; late retransmission (the host has the answer already)
        lda RXBUF + F_ARG
        sta b_counter
        lda RXBUF + F_ARG + 2   ; sector = start + slot
        ldx #$00
        ldy #$00
        ldz #$00
        clc
        adcq RXBUF + F_ARG + 3
        stq tmp
        ldz #$00
        jsr sd_wait
        +copy RXBUF + F_PL + 14, SDBUF, 512
        jsr sd_sector
        lda #$03                ; single sector write
        jsr sd_write
        jsr count_wr
        jsr sd_wait
        jsr sd_read_tmp         ; read back and compare
        jsr sd_wait
        +copy SDBUF, VBUF1, 512
        +copy RXBUF + F_PL + 14, VBUF2, 512
        jsr compare
        beq +
        ldx #msg_verify - msgs
        jmp fatal
+       lda RXBUF + F_ARG       ; answer: counter, 0, 0, sector
        sta TXBUF + F_ARG
        lda #$00
        sta TXBUF + F_ARG + 1
        sta TXBUF + F_ARG + 2
        ldq tmp
        stq TXBUF + F_ARG + 3
        ldz #$00
        lda #14
        jmp reply
.ignore:
        rts

batch:  cmp #128
        lbcs .ignore
        lda b_active
        bne +
        lda RXBUF + F_ARG       ; counter
        cmp b_counter
        lbeq ack                 ; a batch that is complete already: just acknowledge
        sta b_counter           ; new batch
        lda RXBUF + F_ARG + 1
        sta b_max
        inc
        sta b_left
        ldq RXBUF + F_ARG + 3
        stq b_start
        ldz #$00
        lda #$00
        sta b_written
        ldx #127
-       sta FLAGS,x
        dex
        bpl -
        inc b_active
+       lda RXBUF + F_ARG
        cmp b_counter
        lbne ack                 ; another batch: acknowledge only
        ldx RXBUF + F_ARG + 2   ; slot
        cpx b_max
        beq +
        bcc +
        ldx #msg_slot - msgs
        jmp fatal
+       jsr cache_addr          ; dma_dst = cache slot X
        lda FLAGS,x
        beq +
        ; duplicate: must carry the same data
        ldq dma_dst
        stq dma_src
        ldz #$00
        +set32 dma_dst, VBUF1
        jsr dma_copy512
        +copy RXBUF + F_PL + 14, VBUF2, 512
        jsr compare
        beq ack
        ldx #msg_duplicate - msgs
        jmp fatal
+       inc FLAGS,x             ; new sector: into the cache
        +set32 dma_src, RXBUF + F_PL + 14
        jsr dma_copy512
        dec b_left
        beq +
        jsr ack                 ; acknowledge first, then write what is in order
        jmp flush
+       jsr flush               ; last sector: write and read back the whole batch before the
        jmp ack                 ; answer, so that the host only goes on once it is on the card

ack:    ldx #6                  ; answer: counter, size - 1, slot, start (as received)
-       lda RXBUF + F_ARG,x
        sta TXBUF + F_ARG,x
        dex
        bpl -
        lda #14
        jmp reply

; write the cached sectors that are next in order; when all are written, read them back
flush:  ldx b_written
        cpx b_max
        beq +
        lbcs .done
+       lda FLAGS,x
        lbeq .wait               ; not received yet
        jsr cache_addr
        ldq dma_dst
        stq dma_src
        ldz #$00
        jsr sd_wait
        +set32 dma_dst, SDBUF
        jsr dma_copy512
        ldx b_written
        lda #$05                ; multi-sector write: middle
        cpx b_max
        bne +
        lda #$06                ; end
+       cpx #0
        bne +
        ldq b_start
        stq tmp
        ldz #$00
        jsr sd_sector
        lda #$04                ; start
+       jsr sd_write
        jsr count_wr
        inc b_written
        lbra flush
.done:  lda #$00                ; complete: read back and compare
        sta b_active
        sta cmd                 ; slot
        ldq b_start
        stq tmp
        ldz #$00
.verify:
        jsr sd_wait
        jsr sd_read_tmp
        ldx cmd
        jsr cache_addr
        ldq dma_dst
        stq dma_src
        ldz #$00
        +set32 dma_dst, VBUF2
        jsr dma_copy512
        jsr sd_wait
        +copy SDBUF, VBUF1, 512
        jsr compare
        beq +
        ldx #msg_verify - msgs
        jmp fatal
+       ldq tmp
        inq
        stq tmp
        ldz #$00
        lda cmd
        cmp b_max
        lbeq .wait
        inc cmd
        bra .verify
.wait:  rts

count_wr:
        ldq n_wr
        inq
        stq n_wr
        ldz #$00
        rts

; carry set if the request's batch counter is older than the current one (late duplicate)
outdated:
        lda b_counter
        sec
        sbc RXBUF + F_ARG
        beq +                   ; equal: not outdated
        cmp #$80                ; (current - received) < $80: older
        bcs +
        sec
        rts
+       clc
        rts

; dma_dst = CACHE + slot X * 512
cache_addr:
        txa
        asl
        sta dma_dst + 1
        lda #$00
        sta dma_dst
        sta dma_dst + 3
        lda #^CACHE
        sta dma_dst + 2
        rts

; ---------------------------------------------------------------- SD card
sd_wait:
        lda $d680
        and #$03
        bne sd_wait
        rts

sd_sector:                      ; sector number tmp -> controller
        ldq tmp
        stq $d681
        ldz #$00
        rts

sd_read_tmp:                    ; start reading sector tmp
        jsr sd_sector
        lda #$02
        bra sd_cmd
sd_read:                        ; start reading sector r_sector
        jsr sd_wait
        ldq r_sector
        stq $d681
        ldz #$00
        lda #$02
        bra sd_cmd
sd_write:                       ; A = write command
        ldy #$57                ; open the write gate first
        sty $d680
sd_cmd: sta $d680
        ldy #$00                ; give the controller time to show busy
-       dey
        bne -
        rts

; Z set if VBUF1 and VBUF2 are equal
compare:
        ldx #0
-       lda VBUF1,x
        cmp VBUF2,x
        bne +
        lda VBUF1 + 256,x
        cmp VBUF2 + 256,x
        bne +
        inx
        bne -
+       rts

; ---------------------------------------------------------------- neighbor discovery
icmp:   lda RXBUF + F_UDP       ; ICMPv6 type 135: neighbor solicitation
        cmp #135
        bne +
        ldx #15                 ; ... for our address
-       lda RXBUF + F_PL,x
        cmp ip_local,x
        bne +
        dex
        bpl -
        ldx #5                  ; advertisement to the solicitor
-       lda RXBUF + F_ETHSRC,x
        sta NDBUF,x
        dex
        bpl -
        ldx #15
-       lda RXBUF + F_IPSRC,x
        sta NDBUF + F_IPDST,x
        dex
        bpl -
        lda #$00
        sta NDBUF + F_UDP + 2   ; ICMPv6 checksum
        sta NDBUF + F_UDP + 3
        lda #<(NDBUF + F_IPSRC)
        sta cs_ptr
        lda #>(NDBUF + F_IPSRC)
        sta cs_ptr + 1
        lda #16                 ; addresses + 32-byte message
        sta cs_cnt
        lda #32
        sta tmp
        lda #$00
        sta tmp + 1
        lda #58
        jsr checksum
        lda csum
        eor #$ff
        sta NDBUF + F_UDP + 2
        lda csum + 1
        eor #$ff
        sta NDBUF + F_UDP + 3
        +set32 dma_src, NDBUF
        lda #86
        ldx #0
        jmp transmit
+       rts

; ---------------------------------------------------------------- replies
reply:  sta plen                ; A = payload length (< 256)
        lda #$00
        sta plen + 1
reply_plen:                     ; sequence number and opcode as in the request
        lda RXBUF + F_SEQ
        sta TXBUF + F_SEQ
        lda RXBUF + F_SEQ + 1
        sta TXBUF + F_SEQ + 1
        lda RXBUF + F_OP
        sta TXBUF + F_OP
send:   ; TXBUF payload complete, plen = its length
        lda plen                ; UDP length = IPv6 payload length = 8 + plen
        clc
        adc #8
        sta tmp
        sta TXBUF + F_IPLEN + 1
        sta TXBUF + F_UDP + 5
        lda plen + 1
        adc #$00
        sta tmp + 1
        sta TXBUF + F_IPLEN
        sta TXBUF + F_UDP + 4
        lda #$00
        sta TXBUF + F_UDP + 6   ; checksum
        sta TXBUF + F_UDP + 7
        lda #<(TXBUF + F_PL)    ; zeros after the payload for the 32-bit sum
        clc
        adc plen
        sta ptr
        lda #>(TXBUF + F_PL)
        adc plen + 1
        sta ptr + 1
        lda #$00
        ldy #2
-       sta (ptr),y
        dey
        bpl -
        lda #<(TXBUF + F_IPSRC)
        ldx #>(TXBUF + F_IPSRC)
        jsr checksum_udp
        lda csum
        eor #$ff
        sta TXBUF + F_UDP + 6
        lda csum + 1
        eor #$ff
        sta TXBUF + F_UDP + 7
        ora TXBUF + F_UDP + 6
        bne +
        lda #$ff                ; a checksum of 0 is sent as $FFFF
        sta TXBUF + F_UDP + 6
        sta TXBUF + F_UDP + 7
+       +set32 dma_src, TXBUF
        lda plen                ; frame length = 62 + plen
        clc
        adc #F_PL
        tay
        lda plen + 1
        adc #$00
        tax
        tya
        ; fall through

transmit:                       ; frame at dma_src, length A (low) / X (high)
        sta dma_len
        stx dma_len + 1
        jsr wait_tx
        +set32 dma_dst, ETHBUF
        jsr dma_copy
        lda dma_len
        sta $d6e2
        lda dma_len + 1
        sta $d6e3
        lda #$01
        sta $d6e4               ; send
        rts

wait_tx:
        lda $d6e0               ; bit 7: TX ready
        bpl wait_tx
        rts

; ---------------------------------------------------------------- checksum
; UDP checksum over the frame at A/X (the IPv6 source address): pseudo header (addresses,
; length tmp, next header 17) and the UDP datagram of length tmp, zero padded to 4 bytes.
checksum_udp:
        sta cs_ptr
        stx cs_ptr + 1
        lda tmp                 ; dwords = (32 + length + 3) / 4
        clc
        adc #32 + 3
        sta cs_cnt
        lda tmp + 1
        adc #$00
        lsr
        ror cs_cnt
        lsr
        ror cs_cnt
        lda #17

; One's complement sum of cs_cnt dwords at cs_ptr plus the pseudo header's length (tmp) and
; next header (A). Result in csum (little-endian: store it as is into the packet).
checksum:
        clc
        adc tmp                 ; pseudo header tail as one dword (memory order):
        taz                     ;   0, 0, length high, length low + next header
        lda #$00
        adc #$00                ; carry out of byte 3 wraps around into byte 0
        ldx #$00
        ldy tmp + 1
        clc
-       adcq (cs_ptr)
        inw cs_ptr
        inw cs_ptr
        inw cs_ptr
        inw cs_ptr
        dec cs_cnt
        bne -
        stq sum
        ldz #$00
        lda sum                 ; final carry
        adc #$00
        sta sum
        lda sum + 1
        adc #$00
        sta sum + 1
        lda sum + 2
        adc #$00
        sta sum + 2
        lda sum + 3
        adc #$00
        sta sum + 3
        bcc +
        inc sum
+       clc                     ; fold 32 -> 16 bits
        lda sum
        adc sum + 2
        sta csum
        lda sum + 1
        adc sum + 3
        sta csum + 1
        lda csum
        adc #$00
        sta csum
        lda csum + 1
        adc #$00
        sta csum + 1
        bcc +
        inc csum
+       rts

; ---------------------------------------------------------------- DMA
dma_fill:                       ; dma_len bytes at dma_dst := low byte of dma_src
        lda #$03
        sta dc_cmd
        jsr dma_copy
        lda #$00
        sta dc_cmd
        rts

dma_copy512:
        lda #<512
        ldx #>512
        sta dma_len
        stx dma_len + 1
dma_copy:                       ; dma_len bytes from dma_src to dma_dst (28-bit addresses)
        lda dma_src
        sta dc_src
        lda dma_src + 1
        sta dc_src + 1
        lda dma_src + 2
        and #$0f
        sta dc_srcbank
        lda dma_src + 3
        asl
        asl
        asl
        asl
        sta dc_srcmb
        lda dma_src + 2
        lsr
        lsr
        lsr
        lsr
        tsb dc_srcmb
        lda dma_dst
        sta dc_dst
        lda dma_dst + 1
        sta dc_dst + 1
        lda dma_dst + 2
        and #$0f
        sta dc_dstbank
        lda dma_dst + 3
        asl
        asl
        asl
        asl
        sta dc_dstmb
        lda dma_dst + 2
        lsr
        lsr
        lsr
        lsr
        tsb dc_dstmb
        lda dma_len
        sta dc_len
        lda dma_len + 1
        sta dc_len + 1
        sta $d707               ; in-line DMA job (this list is patched above)
        !byte $0b, $80
dc_srcmb:
        !byte $00
        !byte $81
dc_dstmb:
        !byte $00
        !byte $00               ; end of options
dc_cmd: !byte $00               ; copy (or fill)
dc_len: !word $0000
dc_src: !word $0000
dc_srcbank:
        !byte $00
dc_dst: !word $0000
dc_dstbank:
        !byte $00
        !byte $00
        !word $0000
        rts

; ---------------------------------------------------------------- screen and frames
; 80 x 50 text: with the hot registers on the VIC-IV derives the geometry (columns, rows, line
; step, borders) from the legacy registers; then our own screen and character set, with the
; hot registers off so that they stay
setup_vic:
        lda #$80
        tsb $d05d
        lda #$1b                ; text, display on, 25 rows (VIC-II view)
        sta $d011
        lda #$c8                ; 40 columns, no multicolour
        sta $d016
        lda #$c8                ; H640, FAST, V400
        sta $d031
        lda #$00
        sta $d015               ; no sprites
        sta $d020
        sta $d021
        lda #$87                ; no 16-bit characters, full colour or alpha blending
        trb $d054
        ldx #$00                ; let the VIC take it over
-       dex
        bne -
        lda #$80
        trb $d05d
        lda #<SCREEN
        sta $d060
        lda #>SCREEN
        sta $d061
        lda #$00
        sta $d062
        sta $d064               ; colour RAM from its start
        sta $d065
        lda #$0f
        trb $d063
        lda #<CHARSET
        sta $d068
        lda #>CHARSET
        sta $d069
        lda #^CHARSET
        sta $d06a
        rts

init_screen:
        ; the screen of an earlier helper (each tool starts the helper again): its log stays
        ldx #title_end - title - 1
-       lda title,x
        ora #$80
        cmp SCREEN + 1,x
        lbne .cold
        dex
        bpl -
        lda LOG_NEXT            ; the log goes on where it ended (if that is plausible)
        cmp #ROW_LOG
        bcc .full
        cmp #ROWS + 1
        bcc +
.full:  lda #ROWS
        sta LOG_NEXT
+       lda $d031               ; and still shown as we set it up: then nothing is changed,
        cmp #$c8                ; so the screen does not flicker on every command
        bne .vic
        bit $d05d               ; hot registers off
        bmi .vic
        lda $d060
        cmp #<SCREEN
        bne .vic
        lda $d061
        cmp #>SCREEN
        bne .vic
        lda $d062
        bne .vic
        lda $d069
        cmp #>CHARSET
        bne .vic
        lda $d06a
        cmp #^CHARSET
        bne .vic
        jmp .texts
.vic:   jsr setup_vic
        lda #<(ROW_LOG * COLS)  ; clear only the rows above the log
        ldx #>(ROW_LOG * COLS)
        bra .clear
.cold:  jsr setup_vic
        lda #ROW_LOG            ; an empty log
        sta LOG_NEXT
        lda #<(ROWS * COLS)
        ldx #>(ROWS * COLS)
.clear: sta clr_screen
        sta clr_colour
        stx clr_screen + 1
        stx clr_colour + 1
        sta $d707               ; spaces on the screen, green text
        !byte $0b, $81, $00, $00
        !byte $07               ; fill, chained
clr_screen:
        !word COLS * ROWS       ; count
        !word $0020             ; fill value
        !byte $00
        !word SCREEN
        !byte $00
        !byte $00
        !word $0000
        !byte $81, (COLRAM >> 20) & $ff, $00
        !byte $07               ; fill, chained
clr_colour:
        !word COLS * ROWS
        !word $0005
        !byte $00
        !word COLRAM & $ffff
        !byte (COLRAM >> 16) & $0f
        !byte $00
        !word $0000
        !byte $00
        !byte $03               ; fill: the title row white
        !word COLS
        !word $0001
        !byte $00
        !word COLRAM & $ffff
        !byte (COLRAM >> 16) & $0f
        !byte $00
        !word $0000
        ldx #COLS - 1           ; title row reversed, separator line above the log
-       lda #$a0
        sta SCREEN,x
        lda #$40
        sta SCREEN + ROW_LINE * COLS,x
        dex
        bpl -
.texts:
        ldx #0                  ; texts: address, [$80 = reversed,] screen codes, 0;
.text:  lda texts,x             ; address 0 ends
        sta ptr
        lda texts + 1,x
        beq +++
        sta ptr + 1
        inx
        inx
        lda #$00
        sta lead
        lda texts,x
        cmp #$80
        bne +
        sta lead
        inx
+       ldy #0
-       lda texts,x
        inx
        cmp #0
        beq .text
        ora lead
        sta (ptr),y
        iny
        bra -
+++     jsr show_stats
        ldx #msg_waiting - msgs
        ; fall through

status:                         ; message X (offset in msgs) in the status row
        ldy #0
-       lda msgs,x
        beq +
        sta SCREEN + ROW_STATUS * COLS + COL_TOTAL,y
        inx
        iny
        bra -
+       lda #' '
-       cpy #COLS - COL_TOTAL
        beq +
        sta SCREEN + ROW_STATUS * COLS + COL_TOTAL,y
        iny
        bra -
+       rts

fatal:  jsr status              ; message X, then stop: the host notices the silence
        ldx #fatal_end - fatal_text - 1
-       lda fatal_text,x
        sta SCREEN + ROW_STATUS * COLS + COLS - (fatal_end - fatal_text),x
        dex
        bpl -
-       lda $d7fa               ; border blinks red: stopped (steady red: busy)
        and #$20
        beq +
        lda #2
+       sta $d020
        lda $d610               ; RUN/STOP or ESC: reset
        beq -
        sta $d610
        cmp #$03
        lbeq quit65
        cmp #$1b
        lbeq quit65
        bra -

fatal_text:
        !scr "run/stop: reset"
fatal_end:

title:  !scr "m65fs transfer helper"
title_end:

texts:  +at 0, 1
        !scr $80, "m65fs transfer helper", 0
        +at 0, COLS - 31
        !scr $80, "run/stop: quit to basic (idle)", 0
        +at ROW_STATUS, 1
        !scr "status", 0
        +at ROW_STATS, 1
        !scr "requests", 0
        +at ROW_STATS, COL_RATE + 11
        !scr "/s", 0
        +at ROW_STATS + 1, 1
        !scr "read", 0
        +at ROW_STATS + 1, COL_TOTAL + 11
        !scr "KiB", 0
        +at ROW_STATS + 1, COL_RATE + 11
        !scr "KiB/s", 0
        +at ROW_STATS + 2, 1
        !scr "written", 0
        +at ROW_STATS + 2, COL_TOTAL + 11
        !scr "KiB", 0
        +at ROW_STATS + 2, COL_RATE + 11
        !scr "KiB/s", 0
        +at ROW_STATS + 3, 1
        !scr "running", 0
        +at ROW_STATS + 3, COL_TOTAL + 11
        !scr "s", 0
        !word 0

msgs:
msg_waiting:   !scr "waiting for the host", 0
msg_connected: !scr "connected", 0
msg_busy:      !scr "busy: press run/stop again when idle", 0
msg_quit:      !scr "quit", 0
msg_mixed:     !scr "error: read during a write batch", 0
msg_conflict:  !scr "error: single write during a batch", 0
msg_slot:      !scr "error: batch slot out of range", 0
msg_duplicate: !scr "error: duplicate with other data", 0
msg_verify:    !scr "error: sector verification failed", 0
msg_nomac:     !scr "error: no mac address configured", 0

; ---------------------------------------------------------------- keyboard, statistics
; RUN/STOP or ESC: quit into MEGA65 mode when idle
keys:   lda $d610               ; hardware keyboard queue (ASCII), 0 = empty
        beq .krts
        sta $d610               ; take it out
        cmp #$03
        beq +
        cmp #$1b
        bne .krts
+       jsr is_idle
        bcc +
        ldx #msg_quit - msgs
        jsr status
        jmp quit65
+       ldx #msg_busy - msgs
        jmp status
.krts:  rts

; until no key of the keyboard matrix has been down for about 50 ms (CIA 1), then an empty
; keyboard queue
wait_keys:
        lda #$ff                ; port A drives the columns, port B reads the rows
        sta $dc02
        lda #$00
        sta $dc03
        sta $dc00               ; all columns
.wk_restart:
        ldy #100                ; 100 x ~0.5 ms without a key
.wk_check:
        lda $dc01
        cmp #$ff
        bne .wk_restart
        ldx #$00                ; ~0.5 ms at 40 MHz: 32 x 256 loops
        ldz #$20
.wk_delay:
        dex
        bne .wk_delay
        dez
        bne .wk_delay
        dey
        bne .wk_check
        ldz #$00
-       lda $d610               ; and whatever is still queued
        beq +
        sta $d610
        bra -
+       rts

; carry set if idle: no write batch open, no request for IDLE_SECS seconds (the requests
; per second shown were 0 that many times in a row)
is_idle:
        lda b_active
        bne +
        lda idle
        cmp #IDLE_SECS
        rts
+       clc
        rts

; once a second: the statistics
tick:   lda $d7fa
        sec
        sbc frame
        cmp fps
        bcc .krts
        lda frame
        clc
        adc fps
        sta frame
        inc idle
        bne +
        dec idle                ; stays at 255
+       jsr is_idle
        bcc +
        lda #5                  ; border green: idle
        sta $d020
+       ldq secs
        inq
        stq secs
        ldz #$00
        ; fall through

show_stats:
        ldq n_req
        stq num
        ldz #$00
        lda #<(SCREEN + ROW_STATS * COLS + COL_TOTAL)
        ldx #>(SCREEN + ROW_STATS * COLS + COL_TOTAL)
        jsr print_num
        ldq n_req               ; requests in the last second
        sec
        sbcq s_req
        stq num
        ldq n_req
        stq s_req
        ldz #$00
        lda #<(SCREEN + ROW_STATS * COLS + COL_RATE)
        ldx #>(SCREEN + ROW_STATS * COLS + COL_RATE)
        jsr print_num
        ldq n_rd                ; sectors / 2 = KiB
        lsrq
        stq num
        ldz #$00
        lda #<(SCREEN + (ROW_STATS + 1) * COLS + COL_TOTAL)
        ldx #>(SCREEN + (ROW_STATS + 1) * COLS + COL_TOTAL)
        jsr print_num
        ldq n_rd
        sec
        sbcq s_rd
        lsrq
        stq num
        ldq n_rd
        stq s_rd
        ldz #$00
        lda #<(SCREEN + (ROW_STATS + 1) * COLS + COL_RATE)
        ldx #>(SCREEN + (ROW_STATS + 1) * COLS + COL_RATE)
        jsr print_num
        ldq n_wr
        lsrq
        stq num
        ldz #$00
        lda #<(SCREEN + (ROW_STATS + 2) * COLS + COL_TOTAL)
        ldx #>(SCREEN + (ROW_STATS + 2) * COLS + COL_TOTAL)
        jsr print_num
        ldq n_wr
        sec
        sbcq s_wr
        lsrq
        stq num
        ldq n_wr
        stq s_wr
        ldz #$00
        lda #<(SCREEN + (ROW_STATS + 2) * COLS + COL_RATE)
        ldx #>(SCREEN + (ROW_STATS + 2) * COLS + COL_RATE)
        jsr print_num
        ldq secs
        stq num
        ldz #$00
        lda #<(SCREEN + (ROW_STATS + 3) * COLS + COL_TOTAL)
        ldx #>(SCREEN + (ROW_STATS + 3) * COLS + COL_TOTAL)
        ; fall through

; num as 10 decimal digits, right aligned, at A/X
print_num:
        sta ptr
        stx ptr + 1
        lda #$00
        ldx #4
-       sta bcd,x
        dex
        bpl -
        sta lead
        ldx #32                 ; binary -> BCD: shift in bit by bit, doubling in decimal
        sed
--      asl num
        rol num + 1
        rol num + 2
        rol num + 3
        lda bcd                 ; (no compare in between: the carry goes through)
        adc bcd
        sta bcd
        lda bcd + 1
        adc bcd + 1
        sta bcd + 1
        lda bcd + 2
        adc bcd + 2
        sta bcd + 2
        lda bcd + 3
        adc bcd + 3
        sta bcd + 3
        lda bcd + 4
        adc bcd + 4
        sta bcd + 4
        dex
        bne --
        cld
        ldy #0
        ldx #4
-       lda bcd,x
        lsr
        lsr
        lsr
        lsr
        jsr .digit
        lda bcd,x
        and #$0f
        jsr .digit
        dex
        bpl -
        rts
.digit: bne +                   ; leading zeros as spaces, but always the last digit
        bit lead
        bmi +
        cpy #9
        beq +
        lda #' '
        bra ++
+       ora #'0'
        pha
        lda #$80
        sta lead
        pla
++      sta (ptr),y
        iny
        rts

; ---------------------------------------------------------------- host lines
; $14 text: colour, mode (0 = new line, 1 = replace the last line), up to 80 screen codes.
; Answer: the header only.
op_text:
        lda ulen + 1
        lbne .trts
        lda ulen                ; UDP length 17 + text length
        sec
        sbc #17
        lbcc .trts
        cmp #COLS + 1
        lbcs .trts
        sta tlen
        lda LOG_NEXT            ; the row: the next free one, or (replace) the last line
        ldx RXBUF + F_ARG + 1
        beq .new
        cmp #ROW_LOG + 1
        bcc .new                ; nothing to replace: a new line after all
        sec
        sbc #1
        bra .row
.new:   cmp #ROWS
        bcc +
        ; full: the log up one row (screen and colours), the line goes into the last row.
        ; Only while the VIC does not draw the log: otherwise one frame shows the rows above
        ; the beam unscrolled (a jolt over the whole log). Started below the log (bottom
        ; border, vertical blank), the copy is done long before the beam reaches the log
        ; again. VIC-II raster lines: text from 51, 4 per row (V400), the log ends at 251.
-       bit $d011               ; raster 256 and more
        bmi +
        lda $d012
        cmp #251
        bcc -
+       +copy LOG + COLS, LOG, (ROWS - ROW_LOG - 1) * COLS
        +copy COLRAM + ROW_LOG * COLS + COLS, COLRAM + ROW_LOG * COLS, (ROWS - ROW_LOG - 1) * COLS
        lda #ROWS - 1
        bra .row
+       inc LOG_NEXT
.row:   sta roff                ; roff = row * 80 = row * 5 * 16 (row * 5 fits a byte)
        asl
        asl
        clc
        adc roff
        sta roff
        lda #$00
        sta roff + 1
        ldx #4
-       asl roff
        rol roff + 1
        dex
        bne -
        lda roff
        clc
        adc #<SCREEN
        sta ptr
        lda roff + 1
        adc #>SCREEN
        sta ptr + 1
        ldx #0
        ldy #0
-       cpy tlen
        bcs +
        lda RXBUF + F_ARG + 2,y
        sta (ptr),y
        iny
        bra -
+       lda #' '
-       cpy #COLS
        beq +
        sta (ptr),y
        iny
        bra -
+       lda RXBUF + F_ARG       ; colour of the line
        ldx #$00
        ldy #$00
        ldz #$00
        stq dma_src
        lda roff                ; COLRAM + roff
        sta dma_dst
        lda roff + 1
        sta dma_dst + 1
        lda #(COLRAM >> 16) & $ff
        sta dma_dst + 2
        lda #COLRAM >> 24
        sta dma_dst + 3
        lda #<COLS
        ldx #>COLS
        sta dma_len
        stx dma_len + 1
        jsr dma_fill
        lda #7
        jmp reply
.trts:  rts

; own address from the MAC; the constant parts of the reply and advertisement frames
init_frames:
        lda $d6e9
        ora $d6ea
        ora $d6eb
        ora $d6ec
        ora $d6ed
        ora $d6ee
        bne +
        ldx #msg_nomac - msgs
        jmp fatal
+       sta $d707               ; both frames start out all zero (ICMPv6 code, reserved bytes,
        !byte $0b, $81, $00, $00        ; ... must be 0: RAM holds anything)
        !byte $03               ; fill
        !word NDBUF + 86 - TXBUF
        !word $0000
        !byte $00
        !word TXBUF
        !byte $00
        !byte $00
        !word $0000
        ldx #5
-       lda $d6e9,x
        sta TXBUF + F_ETHSRC,x
        sta NDBUF + F_ETHSRC,x
        sta NDBUF + 80,x        ; target link-layer address option
        dex
        bpl -
        lda $d6e9               ; fe80::(MAC with the universal bit flipped, ff:fe inserted)
        eor #$02
        sta ip_local + 8
        lda $d6ea
        sta ip_local + 9
        lda $d6eb
        sta ip_local + 10
        lda $d6ec
        sta ip_local + 13
        lda $d6ed
        sta ip_local + 14
        lda $d6ee
        sta ip_local + 15
        ldx #15
-       lda ip_local,x
        sta TXBUF + F_IPSRC,x
        sta NDBUF + F_IPSRC,x
        sta NDBUF + F_PL,x      ; target address
        dex
        bpl -
        ldx #7
-       lda ip6_hdr,x           ; EtherType, version/class/flow (length set per frame)
        sta TXBUF + F_TYPE,x
        sta NDBUF + F_TYPE,x
        dex
        bpl -
        lda #17                 ; UDP, hop limit 64
        sta TXBUF + F_NH
        lda #64
        sta TXBUF + F_NH + 1
        lda #>PORT
        sta TXBUF + F_UDP
        lda #<PORT
        sta TXBUF + F_UDP + 1
        ldx #3
-       lda mrsp,x
        sta TXBUF + F_PL,x
        dex
        bpl -
        lda #32                 ; advertisement: length 32, ICMPv6, hop limit 255 (required)
        sta NDBUF + F_IPLEN + 1
        lda #58
        sta NDBUF + F_NH
        lda #255
        sta NDBUF + F_NH + 1
        lda #136                ; neighbor advertisement, code 0
        sta NDBUF + F_UDP
        lda #$60                ; solicited, override
        sta NDBUF + F_UDP + 4
        lda #2                  ; option: target link-layer address, 1 x 8 bytes
        sta NDBUF + 78
        lda #1
        sta NDBUF + 79
        rts

ip6_hdr: !byte $86, $dd, $60, $00, $00, $00, $00, $00
ip_local:
        !byte $fe, $80, 0, 0, 0, 0, 0, 0, 0, 0, 0, $ff, $fe, 0, 0, 0

helper_end:
!if helper_end > RXLEN {
        !error "helper code overlaps its buffers"
}
